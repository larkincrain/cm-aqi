# ============================================================================
# CM AQI — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git (it's in .gitignore).
#
# To load these in your shell:
#   export $(cat .env | xargs)
# Or use a tool like direnv: https://direnv.net/

# ============================================================================
# AQICN API (REQUIRED)
# ============================================================================
# Register for a free API token at https://aqicn.org/data-platform/token/
AQICN_API_TOKEN=your_aqicn_api_token_here

# ============================================================================
# Database
# ============================================================================
# PostgreSQL connection URL for production.
# Format: ecto://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# In development, this is configured in config/dev.exs instead.
DATABASE_URL=ecto://postgres:postgres@localhost:5432/cm_aqi_prod

# ============================================================================
# Phoenix
# ============================================================================
# Secret key for signing cookies and tokens. Generate one with:
#   mix phx.gen.secret
SECRET_KEY_BASE=your_secret_key_base_here_generate_with_mix_phx_gen_secret

# The hostname where your app is deployed (e.g., cm-aqi.fly.dev)
PHX_HOST=localhost

# Set to "true" to start the Phoenix web server (required for production)
PHX_SERVER=true

# Port to listen on (default: 4000)
PORT=4000

# ============================================================================
# LINE Messaging API
# ============================================================================
# Get these from the LINE Developers Console:
# https://developers.line.biz/console/
#
# 1. Create a new Provider (or use existing)
# 2. Create a "LINE Login" channel → get CHANNEL_ID and CHANNEL_SECRET
# 3. Create a "Messaging API" channel → get CHANNEL_ACCESS_TOKEN
# 4. Set the callback URL in the LINE Login channel settings

# Your LINE Login channel ID (numeric string)
LINE_CHANNEL_ID=your_line_channel_id

# Your LINE Login channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret

# Your Messaging API long-lived channel access token
# Found in: Messaging API channel → "Channel access token (long-lived)"
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# The full URL where LINE redirects after OAuth login
# Must match exactly what's configured in LINE Developers Console
# Development: http://localhost:4000/auth/line/callback
# Production:  https://your-domain.com/auth/line/callback
LINE_CALLBACK_URL=http://localhost:4000/auth/line/callback
