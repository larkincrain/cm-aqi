#!/bin/sh
set -eu

# Wait for the database to be ready before running migrations.
# The app will crash-loop if Postgres isn't accepting connections yet.
echo "Waiting for database..."

MAX_RETRIES=30
RETRIES=0

until /app/bin/cm_aqi eval "CmAqi.Release.migrate()" > /dev/null; do
  RETRIES=$((RETRIES + 1))
  if [ "$RETRIES" -ge "$MAX_RETRIES" ]; then
    echo "Database still not ready after $MAX_RETRIES attempts. Aborting."
    exit 1
  fi
  echo "Database not ready — retrying in 2s... ($RETRIES/$MAX_RETRIES)"
  sleep 2
done

echo "Migrations complete. Starting server..."
exec /app/bin/server
