# ============================================================================
# CM AQI — Docker Compose Environment Variables
# ============================================================================
# Copy this file to .env and fill in your real API keys:
#   cp .env.docker.example .env
#
# DATABASE_URL is set in docker-compose.yml (overrides any value here).

# Phoenix
SECRET_KEY_BASE=generate_me_with_mix_phx_gen_secret_and_paste_here
PHX_HOST=localhost
PHX_SERVER=true
PORT=4000

# AQICN API (required — get a free token at https://aqicn.org/data-platform/token/)
AQICN_API_TOKEN=your_aqicn_api_token_here

# NASA FIRMS (optional)
FIRMS_MAP_KEY=

# LINE Messaging API (required in production)
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CALLBACK_URL=http://localhost:4000/auth/line/callback
