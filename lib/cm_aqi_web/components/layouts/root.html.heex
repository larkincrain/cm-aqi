<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Dynamic meta description — each LiveView can override via assigns --%>
    <meta
      name="description"
      content={assigns[:meta_description] || "Real-time air quality monitoring for Chiang Mai, Thailand. Track PM2.5, AQI levels, and get LINE notifications during burn season."}
    />
    <.live_title default="CM AQI" suffix=" — Chiang Mai Air Quality">
      {assigns[:page_title]}
    </.live_title>
    <%!-- Favicons --%>
    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link rel="icon" type="image/png" href={~p"/images/icon-192.png"} sizes="192x192" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <%!-- Canonical URL --%>
    <link rel="canonical" href={"#{CmAqiWeb.Endpoint.url()}#{assigns[:canonical_path] || "/"}"} />
    <%!-- Open Graph --%>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CM AQI — Chiang Mai Air Quality" />
    <meta property="og:title" content={"#{assigns[:page_title] || "Dashboard"} — Chiang Mai Air Quality"} />
    <meta property="og:description" content={assigns[:meta_description] || "Real-time air quality monitoring for Chiang Mai, Thailand. Track PM2.5, AQI levels, and get LINE notifications during burn season."} />
    <meta property="og:url" content={"#{CmAqiWeb.Endpoint.url()}#{assigns[:canonical_path] || "/"}"} />
    <meta property="og:image" content={"#{CmAqiWeb.Endpoint.url()}/images/og-image.jpg"} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="676" />
    <meta property="og:locale" content="en_US" />
    <%!-- Twitter Card --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={"#{assigns[:page_title] || "Dashboard"} — Chiang Mai Air Quality"} />
    <meta name="twitter:description" content={assigns[:meta_description] || "Real-time air quality monitoring for Chiang Mai, Thailand. Track PM2.5, AQI levels, and get LINE notifications during burn season."} />
    <meta name="twitter:image" content={"#{CmAqiWeb.Endpoint.url()}/images/og-image.jpg"} />
    <%!-- JSON-LD Structured Data --%>
    <script :if={assigns[:json_ld]} type="application/ld+json">
      {raw(Jason.encode!(assigns[:json_ld]))}
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!--
      CDN libraries must load before app.js since the LiveView hooks depend on them.
      These are synchronous scripts — they execute in order during HTML parsing.
    --%>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js">
    </script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin="">
    </script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js">
    </script>
    <%!-- App JS loads last (defer) so all CDN libs are available when hooks run --%>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      // Apply saved theme immediately to prevent flash of wrong theme.
      // Runs before the page paints because it's a synchronous script in <head>.
      (function() {
        var saved = localStorage.getItem("theme") || "system";
        var theme;
        if (saved === "system") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        } else {
          theme = saved;
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="bg-base-100 min-h-screen">
    {@inner_content}
  </body>
</html>
